# Copy to .env on the server; never commit the populated file.
POSTGRES_USER=infracentra
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=infracentra
# URL-encode reserved characters in the credentials above.
DATABASE_URL=postgresql+asyncpg://infracentra:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/infracentra
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up securely: losing this key makes encrypted integration credentials unrecoverable.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# JSON array containing only the HTTPS frontend origin.
CORS_ORIGINS=["https://app.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required only when the database has no existing platform administrator.
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET_OF_AT_LEAST_16_CHARACTERS
